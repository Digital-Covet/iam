# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
APP_NAME="IAM Digital Covet"
VITE_APP_NAME="IAM Digital Covet"

# Session
SESSION_DRIVER=cookie

# Database — Supabase shared poolers (IPv4-only)
# Runtime: transaction-mode pooler (6543). Migrations: session-mode pooler (5432).
DATABASE_URL="postgresql://postgres.mmccebrbsysejqtrjyfw:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.mmccebrbsysejqtrjyfw:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Supabase Object Storage — profile photos (optional until set)
# Project URL for this workspace:
SUPABASE_URL="https://mmccebrbsysejqtrjyfw.supabase.co"
# Secret API key, sb_secret_... (server only, never expose to the browser):
SUPABASE_SECRET_KEY="[YOUR-SECRET-KEY]"
# Public bucket for avatars (create it in Supabase → Storage, public on):
AVATAR_BUCKET="avatars"
# ZeptoMail (transactional email) - leave token empty to log emails to console
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_SENDER_ADDRESS=noreply@digitalcovet.com

# OAuth/OIDC RS256 signing key (base64 PEM). Generate: node -e "const c=require('crypto');console.log(Buffer.from(c.generateKeyPairSync('rsa',{modulusLength:2048}).privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
OAUTH_PRIVATE_KEY_B64=
LIMITER_STORE=database