<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="IAM Digital Covet — the identity authority for Digital Covet's internal apps."
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#dc2626" />
    <meta name="application-name" content="IAM Digital Covet" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:site_name" content="IAM Digital Covet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="IAM Digital Covet" />
    <meta
      property="og:description"
      content="IAM Digital Covet — the identity authority for Digital Covet's internal apps."
    />
    <meta name="twitter:card" content="summary" />

    <title data-inertia>
      IAM Digital Covet
    </title>

    <script>
      /* Apply the saved theme before first paint to avoid a light flash. */
      try {
        if (/(?:^|; )app_theme=dark/.test(document.cookie)) {
          document.documentElement.classList.add('dark')
        }
      } catch (e) {}
    </script>

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>
